create table if not exists public.orders (
  id text primary key,
  customer_id text not null,
  product text not null,
  amount numeric not null default 0,
  currency text not null default 'INR',
  order_date date,
  shipped_date date,
  delivered_date date,
  expected_delivery date,
  status text not null default 'Processing',
  payment_status text not null default 'Paid',
  transaction_id text,
  return_status text not null default 'Not Applicable',
  refund_status text not null default 'None',
  refund_amount numeric,
  refund_id text,
  cancellation_eligible boolean not null default false,
  exchange_eligible boolean not null default false,
  exchange_status text not null default 'None',
  scenario text not null default '',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

alter table public.orders enable row level security;

create policy "orders_select_demo" on public.orders for select to anon, authenticated using (true);
create policy "orders_insert_demo" on public.orders for insert to anon, authenticated with check (true);
create policy "orders_update_demo" on public.orders for update to anon, authenticated using (true) with check (true);

alter publication supabase_realtime add table public.orders;