create table if not exists public.tickets (
  id text primary key,
  customer_id text not null,
  title text not null default '',
  description text not null default '',
  status text not null default 'Investigating',
  priority text not null default 'Medium',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists public.messages (
  id uuid primary key default gen_random_uuid(),
  ticket_id text not null references public.tickets(id) on delete cascade,
  sender_type text not null check (sender_type in ('customer','ai','agent')),
  message text not null,
  created_at timestamptz not null default now()
);

create index if not exists messages_ticket_id_idx on public.messages (ticket_id, created_at);

-- Row level security: enabled on both tables.
-- The app has no login yet (open demo), so select/insert/update are open to
-- anon + authenticated roles. Tighten to auth.uid() once authentication is added.
alter table public.tickets enable row level security;
alter table public.messages enable row level security;

create policy "tickets_select_demo" on public.tickets
  for select to anon, authenticated using (true);
create policy "tickets_insert_demo" on public.tickets
  for insert to anon, authenticated with check (true);
create policy "tickets_update_demo" on public.tickets
  for update to anon, authenticated using (true) with check (true);

create policy "messages_select_demo" on public.messages
  for select to anon, authenticated using (true);
create policy "messages_insert_demo" on public.messages
  for insert to anon, authenticated with check (true);